# Copy to .env and fill these locally. Never commit .env.
HF_TOKEN=
TARGET_MODEL_PATH=
INITIAL_DRAFT_PATH=
DATASET_REPOS=

# Physical GPU indices. Keep training and inference separate when both run.
TRAIN_GPU_INDEX=1
INFER_GPU_INDEX=0
EXPECTED_TRAIN_GPU_UUID=
EXPECTED_INFER_GPU_UUID=

PROFILE=single_gpu
SHARD_SIZE=128
MAX_SEQ_LENGTH=4096
MIN_FREE_GIB=28
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=30000
HF_HOME=/workspace/.hf_home
